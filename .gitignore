# ========================================================
# ChatSphere .gitignore
# ========================================================

# Environment Variables & Secrets
.env
.env.local
.env.*.local
.env.dev
.env.prod
!.env.example

# Local Spring Boot & Application Credentials
application-local.properties
application-secret.properties
*-local.properties
*.local.properties
*.secret.properties
secrets.properties
credentials.json
service-account*.json

# Keystores, Certificates & Cryptographic Keys
*.pem
*.key
*.p12
*.jks
*.crt
*.der
*.id_rsa
*.id_dsa

# Compiled Output & Build Artifacts
target/
dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Node Dependencies
node_modules/

# OS and Editor Specific Files
.DS_Store
Thumbs.db
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Crash Reports & Dumps
hs_err_pid*
replay_pid*
